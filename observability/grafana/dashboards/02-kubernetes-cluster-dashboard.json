{
  "uid": "smartshop-k8s-cluster",
  "title": "SmartShop — 02 Kubernetes Cluster & Workloads (Pods, Nodes, Deployments, Services, Namespaces)",
  "tags": ["smartshop", "kubernetes", "cluster"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Cluster Nodes Ready",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(kube_node_info)",
          "legendFormat": "Nodes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active Namespaces",
      "type": "stat",
      "gridPos": { "h": 6, "w": 5, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(kube_namespace_created)",
          "legendFormat": "Namespaces",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Running Pods in Cluster",
      "type": "stat",
      "gridPos": { "h": 6, "w": 5, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Running\"})",
          "legendFormat": "Running Pods",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Available Deployments",
      "type": "stat",
      "gridPos": { "h": 6, "w": 5, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(kube_deployment_status_replicas_available)",
          "legendFormat": "Deployments",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Kubernetes Services",
      "type": "stat",
      "gridPos": { "h": 6, "w": 5, "x": 19, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(kube_service_info)",
          "legendFormat": "Services",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Pods Running by Namespace",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (namespace) (kube_pod_status_phase{phase=\"Running\"})",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Deployment Available Replicas in SmartShop",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=~\"smartshop.*\"}",
          "legendFormat": "{{namespace}}/{{deployment}}",
          "refId": "A"
        }
      ]
    }
  ]
}

