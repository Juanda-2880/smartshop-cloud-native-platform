      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:4173/*",
        "http://localhost:8080/*",
        "http://smartshop.local/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:4173",
        "http://localhost:8080",
        "http://smartshop.local",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "smartshop-backend",
      "name": "SmartShop Spring Boot 3.5 OAuth2 Resource Server",
      "enabled": true,
      "publicClient": false,
